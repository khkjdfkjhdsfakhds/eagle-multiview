{
  "name": "eagle-multiview-review-20260905",
  "version": "1.8.0-review.8",
  "description": "Multi-window Eagle client for browsing, organizing, previewing, importing, editing, and synchronizing one library",
  "main": "main.js",
  "author": "Eagle MultiView contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack:mac": "electron-builder --mac dir --arm64",
    "dist:mac": "electron-builder --mac dmg --arm64",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.eagle.multiview.review.20260905",
    "productName": "Eagle MultiView Review",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/copy-image.applescript",
        "to": "copy-image.applescript"
      },
      {
        "from": "eagle-plugin/text-save-service",
        "to": "Eagle TXT Save Plugin"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": ["dmg"],
      "artifactName": "Eagle-MultiView-${version}-${arch}.${ext}",
      "identity": "-"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": ["nsis"],
      "artifactName": "Eagle-MultiView-${version}-Setup.${ext}"
    }
  }
}
